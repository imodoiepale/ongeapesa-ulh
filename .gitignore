# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/
/playwright-report/
/test-results/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# ...but templates must ship: the VPS deploy does `cp .env.example .env`,
# which fails if the template was never committed. Values in it stay blank.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MCP server config (contains API keys)
.mcp.json

# Codex CLI config (contains ElevenLabs API key + n8n bearer token)
.codex/

# graphify temp and cache files
graphify-out/cache/
graphify-out/.graphify_chunk_*.json
graphify-out/.graphify_semantic_new.json
graphify-out/.needs_update

# Claude Code local settings (machine-local; has contained API keys)
.claude
.agents

# n8n credential exports (contain live API keys and OAuth tokens — NEVER commit)
credentials.json
*credentials*.json

# Contains a named NCBA contact's direct email and mobile. This repo is public;
# that is a third party's personal data and a social-engineering vector against
# our banking relationship. Keep it local.
docs/NCBA_CREDENTIALS_RUNBOOK.md

# PWA generated files
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
!public/sw.js
