# Ongea Pesa LiveKit voice worker — copy to .env and fill in.
#   cp .env.example .env
# Every variable below is read by agent.py or by a livekit plugin it loads.

# ── LiveKit ───────────────────────────────────────────────────────────────────
# We SELF-HOST the SFU on this VPS — see livekit-server/docker-compose.hostinger.yml.
# Deploy that first; this worker cannot start without a server to dial.
#
# The key/secret are the pair you generated with:
#   docker run --rm livekit/livekit-server generate-keys
# The server takes them as one LIVEKIT_KEYS="KEY: SECRET" variable; the worker
# takes them as the two separate variables below. Same values, different shape.
#
# All three must ALSO exist in the Next.js environment, or
# /api/voice/livekit-token returns 500 "Voice service is not configured".
LIVEKIT_URL=wss://livekit.srv1631847.hstgr.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Environment gate ──────────────────────────────────────────────────────────
# Step 5 of docs/deployment/VPS_VOICE_WORKER.md tells you to set this here.
# Note: agent.py does NOT read it — only lib/environment.ts does, on the Next.js
# side, where it defaults to 'live' if unset. Set it in Vercel, not just here.
ONGEA_ENVIRONMENT=live

# ── Where the worker posts money commands ─────────────────────────────────────
# Must be the deployed Next.js app, NOT localhost — the worker runs on the VPS.
ONGEA_APP_URL=https://ongeapesa.nsait.co.ke
N8N_WEBHOOK_AUTH_TOKEN=
N8N_CALLBACK_SECRET=

# ── Speech-to-text (the "ears") ───────────────────────────────────────────────
# deepgram      — streaming, lowest latency, language="multi" code-switching (default)
# openai        — gpt-4o-transcribe. SLOWER, but actually covers Swahili
# whisper_sheng — your own fine-tune behind an OpenAI-compatible endpoint
#
# Deepgram is the default for latency; OpenAI is the fallback for language
# coverage. See "Choosing an STT" in README.md before changing this.
ONGEA_STT=deepgram

# For ONGEA_STT=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# NOT "multi" — Deepgram's code-switching covers 10 languages and Swahili is
# not one of them. No Nova model supports Swahili at all. "en" degrades on
# Sheng but stays honest; "multi" returns confident nonsense for Kenyan audio.
DEEPGRAM_LANGUAGE=en

# For ONGEA_STT=openai — the Swahili-capable FALLBACK.
#
# To A/B against Deepgram on a real call, change ONE line above:
#     ONGEA_STT=openai
# then `docker compose restart voice-agent`. Nothing else changes.
#
# The openai plugin reads OPENAI_API_KEY. Set it even while ONGEA_STT=deepgram,
# so switching the fallback on is genuinely a one-line change.
OPENAI_API_KEY=
# Overrides OPENAI_API_KEY for STT only, if you want a separate key.
# ONGEA_STT_API_KEY=
# Defaults to gpt-4o-transcribe (streams, covers Swahili). Do NOT use whisper-1:
# it is batch-only and adds ~0.5-1.5s of dead air per turn.
# ONGEA_STT_MODEL=gpt-4o-mini-transcribe
# Leave UNSET for auto-detection. Setting it forces one language and kills the
# English/Sheng code-switching your users actually speak.
# ONGEA_STT_LANGUAGE=

# For ONGEA_STT=whisper_sheng (self-hosted fine-tune)
# ONGEA_STT_BASE_URL=http://127.0.0.1:8000/v1
# ONGEA_STT_API_KEY=not-needed
# ONGEA_STT_MODEL=whisper-sheng-lora

# ── LLM (intent + tool calling, the "brain") ──────────────────────────────────
# This is already OpenAI. Point ONGEA_LLM_BASE_URL elsewhere for an
# OpenAI-compatible provider (Groq, OpenRouter, vLLM).
ONGEA_LLM_API_KEY=
ONGEA_LLM_MODEL=gpt-4o-mini
# ONGEA_LLM_BASE_URL=

# ── Fish Audio TTS (the "mouth" — TTS only, there is no fishaudio.STT) ────────
FISH_API_KEY=
FISH_TTS_MODEL=s2.1-pro
# Model id from the fish.audio URL after cloning the Ongea voice.
FISH_VOICE_ID=
# balanced | normal — "normal" is higher quality, "balanced" is faster.
FISH_LATENCY=balanced

# Your actual Fish plan rate. Left at 0, TTS cost is NOT recorded (deliberately —
# a zero would read as "this was free" on the economics dashboard).
FISH_USD_PER_1K_CHARS=0
